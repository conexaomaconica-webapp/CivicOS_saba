{
  "name": "saas-platform",
  "private": true,
  "version": "0.0.1",
  "description": "Modular SaaS Platform — Core + Plugins Architecture",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "pnpm --filter @saas/web dev",
    "dev:web": "pnpm --filter @saas/web dev",
    "lint": "node scripts/lint-incremental.mjs",
    "lint:all": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test --concurrency=1 && node architecture-tests.js",
    "clean": "rimraf --glob packages/*/dist packages/*/*.tsbuildinfo plugins/*/dist plugins/*/*.tsbuildinfo apps/*/.next apps/*/*.tsbuildinfo",
    "types:supabase": "node scripts/gen-supabase-types.cjs",
    "types:supabase:local": "node scripts/gen-supabase-types.cjs --local",
    "supabase:start": "node scripts/db-migrate-test.cjs",
    "db:migrate:test": "node scripts/db-migrate-test.cjs",
    "test:rls": "node scripts/run-rls-tests.cjs",
    "test:commercial-db": "node scripts/test-migration-228-233-commercial.mjs",
    "test:commercial-authz": "node scripts/test-migration-234-237-commercial-authz.mjs",
    "test:commercial-leads": "node scripts/test-migration-238-commercial-leads.mjs",
    "test:commercial-link": "node scripts/test-migration-239-commercial-link-attribution.mjs",
    "test:commercial-access": "node scripts/test-migration-240-commercial-representative-access.mjs",
    "test:commercial-contract": "node scripts/test-migration-241-commercial-representative-contract.mjs",
    "test:commercial-reversals": "node scripts/test-migration-242-commercial-provider-reversals.mjs",
    "test:connections-detail": "node scripts/test-migration-246-connection-detail.mjs",
    "test:admin-lodges-list": "node scripts/test-migration-252-admin-lodges-list.mjs",
    "test:connection-register-admin": "node scripts/test-migration-251-connection-register-admin.mjs",
    "test:security-definer-hardening": "node scripts/test-migration-250-security-definer-hardening.mjs",
    "test:analytics-authorization": "node scripts/test-migration-249-analytics-authorization.mjs",
    "test:business-owner-permission": "node scripts/test-migration-248-business-owner-permission.mjs",
    "test:connections-by-business": "node scripts/test-migration-247-connections-list-by-business.mjs",
    "test:connections-list": "node scripts/test-migration-245-connections-list.mjs",
    "test:connections-feed": "node scripts/test-migration-244-connections-feed.mjs",
    "test:commercial-engine": "node scripts/test-migration-243-commercial-commission-engine.mjs",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "verify": "pnpm clean && pnpm install --frozen-lockfile && pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "eslint": "^10.7.0",
    "prettier": "^3.4.0",
    "rimraf": "^5.0.0",
    "supabase": "^2.121.0",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.64.0"
  }
}
