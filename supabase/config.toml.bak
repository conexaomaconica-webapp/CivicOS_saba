# SaaS Platform — Supabase Configuration

[project]
id = "your-project-id"
name = "saas-platform"

[api]
port = 54321
schemas = ["public"]
extra_search_path = ["public", "extensions"]
max_rows = 1000

[db]
port = 54322
shadow_port = 54320
major_version = 15

[studio]
port = 54323

[auth]
site_url = "http://localhost:3000"
additional_redirect_urls = ["http://localhost:3000/auth/callback"]
jwt_expiry = 3600

[auth.external.google]
enabled = false
client_id = ""
secret = ""
redirect_uri = ""
