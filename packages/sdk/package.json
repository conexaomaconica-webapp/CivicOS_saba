{
  "name": "@saas/sdk",
  "version": "1.0.0",
  "private": true,
  "description": "CivicOS Plugin SDK — Builders, helpers, and validation utilities",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@saas/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
