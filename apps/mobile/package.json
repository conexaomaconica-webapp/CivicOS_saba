{
  "name": "@saas/mobile",
  "version": "0.0.1",
  "private": true,
  "description": "Interface mobile local da Conexão Maçônica (iOS/Android)",
  "scripts": {
    "dev": "vite",
    "sync": "pnpm build && cap sync && node scripts/apply-android-overrides.mjs",
    "open:android": "npx cap open android",
    "open:ios": "npx cap open ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capacitor/push-notifications": "^7.0.0",
    "@saas/core": "workspace:*",
    "@saas/ui": "workspace:*",
    "@types/leaflet": "^1.9.22",
    "leaflet": "^1.9.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  }
}
