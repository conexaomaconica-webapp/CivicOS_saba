    "@saas/app-sdk": "workspace:*",
    "@saas/core": "workspace:*",
    "@saas/plugin-community-directory": "workspace:^",
    "@saas/plugin-conexao-maconica": "workspace:*",
    "@saas/sdk": "workspace:*",
    "@saas/shared": "workspace:*",
    "@saas/ui": "workspace:*",
    "@supabase/ssr": "^0.5.0",
    "@supabase/supabase-js": "2.47.0",
    "cmdk": "^1.1.1",
